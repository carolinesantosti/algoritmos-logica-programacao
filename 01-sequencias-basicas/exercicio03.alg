Algoritmo "exercicio3"

Var
   nome: Caractere
   salario: real

Inicio
      Escreva ("Informe o nome do funcionário: ")
      Leia (nome)
      Escreva ("Informe o valor do salário: ")
      Leia (salario)
      Escreva ("A(O) funcionária(o) ", nome, " tem um salário de R$",salario, " em Agosto.")


Fimalgoritmo